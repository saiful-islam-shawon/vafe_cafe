<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="contact_adn_sms.ChatterSmsButton"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension">

        <xpath expr="//button[contains(@class, 'o-mail-Chatter-logNote')]"
               position="after">

            <button t-if="props.threadModel === 'res.partner' and props.threadId"
                    type="button"
                    class="o-mail-Chatter-sendSms btn btn-secondary text-nowrap me-1"
                    t-att-class="{ 'my-2': !props.compactHeight }"
                    t-on-click="onClickContactSms">
                Send SMS
            </button>

        </xpath>

    </t>

</templates>