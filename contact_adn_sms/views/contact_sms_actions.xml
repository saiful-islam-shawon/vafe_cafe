<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hide Odoo default Send SMS from Contact Actions menu -->
    <record id="sms.res_partner_act_window_sms_composer_single" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Hide Odoo default Send SMS for multiple selected Contacts -->
    <record id="sms.res_partner_act_window_sms_composer_multi"
            model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
    </record>

    
    <record id="action_contact_sms_builder" model="ir.actions.act_window">
        <field name="name">Send SMS</field>
        <field name="res_model">sms.builder</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="betopia_sms.sms_builder_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
